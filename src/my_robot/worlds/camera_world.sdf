<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="camera_world">

    <physics name="1ms" type="ignored">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <!-- Physics -->
    <plugin
      filename="gz-sim-physics-system"
      name="gz::sim::systems::Physics">
    </plugin>

    <!-- User commands -->
    <plugin
      filename="gz-sim-user-commands-system"
      name="gz::sim::systems::UserCommands">
    </plugin>

    <!-- Scene broadcaster -->
    <plugin
      filename="gz-sim-scene-broadcaster-system"
      name="gz::sim::systems::SceneBroadcaster">
    </plugin>

    <!-- Sensors -->
    <plugin
      filename="gz-sim-sensors-system"
      name="gz::sim::systems::Sensors">
    </plugin>

    <!-- Ground -->
    <model name="ground_plane">
      <static>true</static>

      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>100 100</size>
            </plane>
          </geometry>
        </visual>
      </link>
    </model>


    <!-- ===================================================== -->
    <!-- APPLE -->
    <!-- ===================================================== -->

    <model name="apple">
      <static>true</static>

      <pose>1.2 0.4 0.10 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <sphere>
              <radius>0.10</radius>
            </sphere>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <sphere>
              <radius>0.10</radius>
            </sphere>
          </geometry>

          <material>
            <ambient>0.8 0.0 0.0 1</ambient>
            <diffuse>0.8 0.0 0.0 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- ===================================================== -->
    <!-- BANANA -->
    <!-- ===================================================== -->

    <model name="banana">
      <static>true</static>

      <pose>1.2 0.0 0.10 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <capsule>
              <radius>0.055</radius>
              <length>0.45</length>
            </capsule>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <capsule>
              <radius>0.055</radius>
              <length>0.45</length>
            </capsule>
          </geometry>

          <material>
            <ambient>1.0 0.8 0.0 1</ambient>
            <diffuse>1.0 0.8 0.0 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- ===================================================== -->
    <!-- CUP -->
    <!-- ===================================================== -->

    <model name="cup">
      <static>true</static>

      <pose>1.2 -0.4 0.15 0 0 0</pose>

      <link name="link">

        <collision name="collision">
          <geometry>
            <cylinder>
              <radius>0.10</radius>
              <length>0.30</length>
            </cylinder>
          </geometry>
        </collision>

        <visual name="visual">
          <geometry>
            <cylinder>
              <radius>0.10</radius>
              <length>0.30</length>
            </cylinder>
          </geometry>

          <material>
            <ambient>0.1 0.3 0.9 1</ambient>
            <diffuse>0.1 0.3 0.9 1</diffuse>
          </material>
        </visual>

      </link>
    </model>


    <!-- Light -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

  </world>
</sdf>